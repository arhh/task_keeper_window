{
  "name": "g-apps-navigator",
  "version": "2.0.0",
  "description": "Desktop web application to interact with G Apps",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhh/task_keeper_window.git"
  },
  "author": "arhh",
  "bugs": {
    "url": "https://github.com/arhh/task_keeper_window/issues"
  },
  "homepage": "https://github.com/arhh/task_keeper_window#readme",
  "devDependencies": {
    "electron-builder": "~26.18.0",
    "electron": "^42.0.1"
  },
  "build": {
    "linux": {
      "category": "Network",
      "target": ["AppImage"],
      "artifactName": "${productName}.${ext}"
    },
    "win": {
      "target": ["msix"]
    }
  },
  "desktopName": "g-apps-navigator"
}
