{
  "name": "g-apps-navigator",
  "productName": "G-Apps Navigator",
  "version": "2.0.0",
  "description": "Desktop web application to interact with G Apps",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhh/task_keeper_window.git"
  },
  "author": "arhh",
  "bugs": {
    "url": "https://github.com/arhh/task_keeper_window/issues"
  },
  "homepage": "https://github.com/arhh/task_keeper_window#readme",
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "~26.18.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.github.arhh.g-apps-navigator",
    "linux": {
      "category": "Network",
      "target": [
        "AppImage"
      ],
      "artifactName": "${name}.${ext}",
      "syncDesktopName": true,
      "icon": "256x256.png"
    }
  },
  "desktopName": "com.github.arhh.g-apps-navigator.desktop",
  "publish": {
    "provider": "github"
  },
  "toolsets": {
    "appImage": "1.0.3"
  }
}
